+@pytest.mark.parametrize("name", RUNNABLE)
+def test_does_not_lose_to_uniform_sampling(name: str, uniform_baseline: Dict[Tuple[str, int], float]) -> None:
+    """No arm may leave the median cell *worse* than uniform sampling.
+
+    The one claim that holds across the whole roster.  Three problems x
+    twelve seeds at the same budget; per cell the statistic is
+    ``log10(best_arm / best_uniform)``, and the verdict is its median.
+
+    ``Random`` is measured like every other arm, which pins the fact that the
+    splitter-aware sampler really does beat the uniform null.
+    """
+    measured = BEATS_UNIFORM_MEASURED.get(name)
+    assert measured is not None, (
+        "%s has no recorded beats-uniform measurement.  Measure its median log-ratio over "
+        "both seed blocks (see BEATS_UNIFORM_MEASURED) and record the pair with the commit -- "
+        "rather than leaving the arm unmeasured." % name
+    )
+    if min(measured) > NO_HARM_BAR:
+        pytest.xfail(
+            "%s: recorded median log-ratio %+.3f / %+.3f (blocks A / B) is above the no-harm "
+            "bar %+.2f -- %s" % (name, measured[0], measured[1], NO_HARM_BAR, BELOW_BAR_REASON[name])
+        )
+    median = _median_log_ratio(name, uniform_baseline)
+    assert median <= NO_HARM_BAR, _drift_message(name, median, NO_HARM_BAR, measured, "no-harm")
